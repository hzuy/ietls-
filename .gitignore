# Dependencies
node_modules/
**/node_modules/

# Environment variables
.env
**/.env
backend/docker-dev.env
# Bắt luôn file env đặt tên tự do (không chỉ bắt đầu bằng ".env", vd docker-dev.env,
# hay dạng ".env.<gì đó>") — chặn credentials lọt vào git kể cả khi ai đó đặt tên
# file env khác quy ước ".env"/".env.local" thông thường.
**/*.env
**/.env.*
# Loại trừ: các file .env.example / frontend/.env.production đã track sẵn trong repo,
# chỉ chứa placeholder hoặc giá trị build-time công khai (VITE_*), không phải secret thật.
!**/.env.example
!frontend/.env.production

# Build output
frontend/dist/

# Test coverage reports (generated)
coverage/
**/coverage/

# Uploads (audio/images - không commit lên git)
backend/uploads/*
!backend/uploads/.gitkeep

# Prisma generated client
backend/node_modules/.prisma/

# Postgres dump/backup files (P9 self-host prep) — chứa dữ liệu thật, không commit
backend/scripts/pg-migrate/dumps/
*.dump

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Claude Code — local overrides và worktree tạm (không commit)
.claude/settings.local.json
.claude/worktrees/
