generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                    Int                     @id @default(autoincrement())
  email                 String                  @unique
  password              String?
  name                  String
  role                  String                  @default("user")
  createdAt             DateTime                @default(now())
  isLocked              Boolean                 @default(false)
  requirePasswordChange Boolean                 @default(false)
  googleId              String?                 @unique
  deletedAt             DateTime?
  emailVerified         Boolean                 @default(true)
  answerLogs            AnswerLog[]
  attempts              Attempt[]
  auditLogs             AuditLog[]
  EmailVerificationCode EmailVerificationCode[]
  speakingAnswers       SpeakingAnswer[]
  speakingCriterionLogs SpeakingCriterionLog[]
  writingAnswers        WritingAnswer[]
  writingCriterionLogs  WritingCriterionLog[]

  @@index([role])
  @@index([createdAt])
}

model Exam {
  id                Int                @id @default(autoincrement())
  title             String
  skill             String
  createdAt         DateTime           @default(now())
  bookNumber        Int?
  testNumber        Int?
  coverImageUrl     String?
  seriesId          Int?
  deletedAt         DateTime?
  attempts          Attempt[]
  series            ExamSeries?        @relation(fields: [seriesId], references: [id])
  listeningSections ListeningSection[]
  passages          Passage[]
  speakingParts     SpeakingPart[]
  writingTasks      WritingTask[]

  @@index([skill])
  @@index([seriesId, bookNumber, testNumber])
  @@index([createdAt])
}

model Passage {
  id                 Int             @id @default(autoincrement())
  examId             Int
  number             Int
  title              String
  body               String
  subtitle           String?
  letteredParagraphs Boolean         @default(false)
  exam               Exam            @relation(fields: [examId], references: [id], onDelete: Cascade)
  questions          Question[]
  questionGroups     QuestionGroup[]
}

model ListeningSection {
  id             Int             @id @default(autoincrement())
  examId         Int
  number         Int
  context        String
  audioUrl       String?
  transcript     String?
  exam           Exam            @relation(fields: [examId], references: [id], onDelete: Cascade)
  questions      Question[]
  questionGroups QuestionGroup[]
}

model Question {
  id                 Int               @id @default(autoincrement())
  passageId          Int?
  listeningSectionId Int?
  number             Int
  type               String
  questionText       String
  options            String?
  correctAnswer      String
  imageUrl           String?
  groupId            Int?
  explanation        Json?
  answerLogs         AnswerLog[]
  group              QuestionGroup?    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  listeningSection   ListeningSection? @relation(fields: [listeningSectionId], references: [id], onDelete: Cascade)
  passage            Passage?          @relation(fields: [passageId], references: [id], onDelete: Cascade)
  answers            QuestionAnswer[]

  @@index([passageId])
  @@index([listeningSectionId])
  @@index([groupId])
}

model WritingTask {
  id       Int             @id @default(autoincrement())
  examId   Int
  number   Int
  taskType String?
  prompt   String
  imageUrl String?
  minWords Int
  answers  WritingAnswer[]
  exam     Exam            @relation(fields: [examId], references: [id], onDelete: Cascade)
}

model SpeakingPart {
  id        Int                @id @default(autoincrement())
  examId    Int
  number    Int
  cueCard   String?
  answers   SpeakingAnswer[]
  exam      Exam               @relation(fields: [examId], references: [id], onDelete: Cascade)
  questions SpeakingQuestion[]
}

model SpeakingQuestion {
  id           Int          @id @default(autoincrement())
  partId       Int
  orderNum     Int
  questionText String
  part         SpeakingPart @relation(fields: [partId], references: [id], onDelete: Cascade)
}

model Attempt {
  id              Int              @id @default(autoincrement())
  userId          Int
  examId          Int
  score           Float?
  correctCount    Int?
  totalCount      Int?
  aiFeedback      String?
  answers         String?
  finishedAt      DateTime?
  createdAt       DateTime         @default(now())
  isSeeded        Boolean          @default(false)
  answerLogs      AnswerLog[]
  exam            Exam             @relation(fields: [examId], references: [id])
  user            User             @relation(fields: [userId], references: [id])
  questionAnswers QuestionAnswer[]

  @@index([userId])
  @@index([examId])
  @@index([userId, examId])
  @@index([finishedAt])
  @@index([createdAt])
  @@index([userId, finishedAt])
  @@index([finishedAt, createdAt])
  @@index([score])
  @@index([userId, score])
  @@index([examId, score])
}

model QuestionAnswer {
  id         Int      @id @default(autoincrement())
  attemptId  Int
  questionId Int
  userAnswer String
  isCorrect  Boolean?
  attempt    Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id])

  @@index([attemptId])
  @@index([questionId])
}

model AnswerLog {
  id            Int      @id @default(autoincrement())
  userId        Int
  attemptId     Int?
  questionId    Int
  skillType     String
  questionType  String
  isCorrect     Boolean
  userAnswer    String
  correctAnswer String
  createdAt     DateTime @default(now())
  attempt       Attempt? @relation(fields: [attemptId], references: [id])
  question      Question @relation(fields: [questionId], references: [id])
  user          User     @relation(fields: [userId], references: [id])

  @@index([userId, skillType, questionType])
  @@index([userId, isCorrect])
  @@index([questionId])
  @@index([attemptId])
}

model WritingAnswer {
  id            Int                   @id @default(autoincrement())
  userId        Int
  taskId        Int
  essayText     String
  wordCount     Int
  aiFeedback    String?
  aiScore       Float?
  createdAt     DateTime              @default(now())
  status        String                @default("pending")
  error         String?
  task          WritingTask           @relation(fields: [taskId], references: [id])
  user          User                  @relation(fields: [userId], references: [id])
  criterionLogs WritingCriterionLog[]

  @@index([userId])
  @@index([taskId])
  @@index([userId, taskId])
  @@index([createdAt])
}

model SpeakingAnswer {
  id            Int                    @id @default(autoincrement())
  userId        Int
  partId        Int
  transcript    String?
  aiFeedback    String?
  aiScore       Float?
  createdAt     DateTime               @default(now())
  status        String                 @default("pending")
  error         String?
  part          SpeakingPart           @relation(fields: [partId], references: [id])
  user          User                   @relation(fields: [userId], references: [id])
  criterionLogs SpeakingCriterionLog[]

  @@index([userId])
  @@index([partId])
  @@index([userId, partId])
  @@index([createdAt])
}

model WritingCriterionLog {
  id              Int           @id @default(autoincrement())
  userId          Int
  writingAnswerId Int
  criterion       String
  score           Float
  comment         String?
  createdAt       DateTime      @default(now())
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  writingAnswer   WritingAnswer @relation(fields: [writingAnswerId], references: [id], onDelete: Cascade)

  @@index([userId, criterion])
  @@index([writingAnswerId])
}

model SpeakingCriterionLog {
  id               Int            @id @default(autoincrement())
  userId           Int
  speakingAnswerId Int
  criterion        String
  score            Float
  comment          String?
  createdAt        DateTime       @default(now())
  speakingAnswer   SpeakingAnswer @relation(fields: [speakingAnswerId], references: [id], onDelete: Cascade)
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, criterion])
  @@index([speakingAnswerId])
}

model QuestionGroup {
  id              Int               @id @default(autoincrement())
  sectionId       Int?
  qNumberStart    Int               @default(1)
  qNumberEnd      Int               @default(1)
  instruction     String            @default("")
  type            String
  imageUrl        String?
  sortOrder       Int               @default(0)
  passageId       Int?
  canReuse        Boolean           @default(false)
  maxChoices      Int               @default(2)
  matchingOptions MatchingOption[]
  noteSections    NoteSection[]
  questions       Question[]
  passage         Passage?          @relation(fields: [passageId], references: [id], onDelete: Cascade)
  section         ListeningSection? @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId])
  @@index([passageId])
}

model NoteSection {
  id        Int           @id @default(autoincrement())
  groupId   Int
  title     String        @default("")
  sortOrder Int           @default(0)
  lines     NoteLine[]
  group     QuestionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

model NoteLine {
  id                Int         @id @default(autoincrement())
  sectionId         Int
  contentWithTokens String      @default("")
  sortOrder         Int         @default(0)
  lineType          String      @default("content")
  noteSection       NoteSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
}

model BookCover {
  id            Int        @id @default(autoincrement())
  seriesId      Int
  bookNumber    Int
  coverImageUrl String?
  deletedAt     DateTime?
  series        ExamSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@unique([seriesId, bookNumber])
  @@index([deletedAt])
  @@index([seriesId])
}

model ExamSeries {
  id         Int         @id @default(autoincrement())
  name       String
  createdAt  DateTime    @default(now())
  deletedAt  DateTime?
  bookCovers BookCover[]
  exams      Exam[]

  @@index([deletedAt])
}

model Setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model PracticeExam {
  id           Int                @id @default(autoincrement())
  title        String
  skill        String
  level        String?
  thumbnailUrl String?
  audioUrl     String?
  passage      String?
  createdAt    DateTime           @default(now())
  deletedAt    DateTime?
  isNormalized Boolean            @default(false)
  questions    PracticeQuestion[]

  @@index([skill])
  @@index([createdAt])
}

model PracticeQuestion {
  id            Int          @id @default(autoincrement())
  examId        Int
  content       String
  type          String?
  orderNum      Int          @default(0)
  options       String?
  correctAnswer String?
  createdAt     DateTime     @default(now())
  explanation   Json?
  exam          PracticeExam @relation(fields: [examId], references: [id], onDelete: Cascade)
}

model WritingSample {
  id           Int       @id @default(autoincrement())
  title        String
  level        String?
  thumbnailUrl String?
  content      String?
  tags         String?
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?
  examType     String?
  taskType     String?

  @@index([createdAt])
}

model SpeakingSample {
  id           Int                  @id @default(autoincrement())
  title        String
  level        String?
  thumbnailUrl String?
  tags         String?
  createdAt    DateTime             @default(now())
  deletedAt    DateTime?
  examType     String?
  content      String?
  parts        SpeakingSamplePart[]

  @@index([createdAt])
}

model SpeakingSamplePart {
  id          Int                      @id @default(autoincrement())
  sampleId    Int
  partNumber  Int
  title       String?
  description String?
  sample      SpeakingSample           @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  questions   SpeakingSampleQuestion[]
}

model SpeakingSampleQuestion {
  id           Int                @id @default(autoincrement())
  partId       Int
  orderNum     Int
  questionText String
  part         SpeakingSamplePart @relation(fields: [partId], references: [id], onDelete: Cascade)
}

model MatchingOption {
  id           Int           @id @default(autoincrement())
  groupId      Int
  optionLetter String
  optionText   String        @default("")
  sortOrder    Int           @default(0)
  group        QuestionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  actorType   String
  actorUserId Int?
  actorEmail  String?
  actorName   String?
  actorRole   String?
  action      String
  entityType  String
  entityId    Int?
  entityLabel String?
  metadata    Json?
  actorUser   User?    @relation(fields: [actorUserId], references: [id])

  @@index([createdAt])
  @@index([actorUserId])
  @@index([action])
  @@index([entityType, entityId])
}

model EmailVerificationCode {
  id        Int      @id @default(autoincrement())
  userId    Int
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
