generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  role                    String   @default("user")
  isLocked                Boolean  @default(false)
  requirePasswordChange   Boolean  @default(false)
  createdAt               DateTime @default(now())

  attempts        Attempt[]
  writingAnswers  WritingAnswer[]
  speakingAnswers SpeakingAnswer[]
  answerLogs      AnswerLog[]
  writingCriterionLogs  WritingCriterionLog[]
  speakingCriterionLogs SpeakingCriterionLog[]

  @@index([role])
  @@index([createdAt])
}

model Exam {
  id            Int       @id @default(autoincrement())
  title         String
  skill         String    // reading | listening | writing | speaking
  bookNumber    Int?      // Cambridge book number (1-19)
  testNumber    Int?      // Test number within book (1-4)
  coverImageUrl String?   // Cover image for the exam card
  seriesId      Int?
  series        ExamSeries? @relation(fields: [seriesId], references: [id])
  createdAt     DateTime  @default(now())
  deletedAt     DateTime?

  passages          Passage[]
  listeningSections ListeningSection[]
  writingTasks      WritingTask[]
  speakingParts     SpeakingPart[]
  attempts          Attempt[]
  seriesExams       SeriesExam[]

  @@index([skill])
  @@index([seriesId, bookNumber, testNumber])
  @@index([createdAt])
}

// ─── READING ────────────────────────────────────────
model Passage {
  id                 Int     @id @default(autoincrement())
  examId             Int
  number             Int
  title              String
  subtitle           String?
  body               String
  letteredParagraphs Boolean @default(false)

  exam           Exam            @relation(fields: [examId], references: [id], onDelete: Cascade)
  questions      Question[]
  questionGroups QuestionGroup[]
}

// ─── LISTENING ──────────────────────────────────────
model ListeningSection {
  id         Int     @id @default(autoincrement())
  examId     Int
  number     Int
  context    String
  audioUrl   String?
  transcript String?

  exam           Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)
  questions      Question[]
  questionGroups QuestionGroup[]
}

// ─── SHARED QUESTIONS (Reading + Listening) ─────────
model Question {
  id                 Int     @id @default(autoincrement())
  passageId          Int?
  listeningSectionId Int?
  groupId            Int?
  number             Int
  type               String  // mcq | mcq_multi | fill_blank | short_answer | true_false_ng | yes_no_ng | matching | matching_headings | matching_features | matching_paragraph | matching_endings | choose_title | diagram_completion | map_diagram
  questionText       String
  options            String? // JSON array
  correctAnswer      String
  imageUrl           String?

  passage          Passage?          @relation(fields: [passageId], references: [id], onDelete: Cascade)
  listeningSection ListeningSection? @relation(fields: [listeningSectionId], references: [id], onDelete: Cascade)
  group            QuestionGroup?    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  answers          QuestionAnswer[]
  answerLogs       AnswerLog[]

  @@index([passageId])
  @@index([listeningSectionId])
  @@index([groupId])
}

// ─── WRITING ────────────────────────────────────────
model WritingTask {
  id       Int     @id @default(autoincrement())
  examId   Int
  number   Int     // 1 or 2
  taskType String?
  prompt   String
  imageUrl String?
  minWords Int

  exam    Exam            @relation(fields: [examId], references: [id], onDelete: Cascade)
  answers WritingAnswer[]
}

// ─── SPEAKING ───────────────────────────────────────
model SpeakingPart {
  id      Int     @id @default(autoincrement())
  examId  Int
  number  Int     // 1, 2, 3
  cueCard String?

  exam      Exam               @relation(fields: [examId], references: [id], onDelete: Cascade)
  questions SpeakingQuestion[]
  answers   SpeakingAnswer[]
}

model SpeakingQuestion {
  id           Int    @id @default(autoincrement())
  partId       Int
  orderNum     Int
  questionText String

  part SpeakingPart @relation(fields: [partId], references: [id], onDelete: Cascade)
}

// ─── ATTEMPTS ───────────────────────────────────────
model Attempt {
  id         Int       @id @default(autoincrement())
  userId     Int
  examId     Int
  score      Float?
  aiFeedback String?
  answers    String?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  isSeeded   Boolean   @default(false)

  user            User             @relation(fields: [userId], references: [id])
  exam            Exam             @relation(fields: [examId], references: [id])
  questionAnswers QuestionAnswer[]
  answerLogs      AnswerLog[]

  @@index([userId])
  @@index([examId])
  @@index([userId, examId])
  @@index([finishedAt])
  @@index([createdAt])
  @@index([finishedAt, createdAt])
  @@index([userId, score])
  @@index([examId, score])
}

model QuestionAnswer {
  id         Int      @id @default(autoincrement())
  attemptId  Int
  questionId Int
  userAnswer String
  isCorrect  Boolean?

  attempt  Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id])

  @@index([attemptId])
  @@index([questionId])
}

// ─── ANSWER LOG (for AI review & learning analysis) ─────────────────────────────
model AnswerLog {
  id            Int      @id @default(autoincrement())
  userId        Int
  attemptId     Int?
  questionId    Int
  skillType     String   // reading | listening
  questionType  String   // mcq | fill_blank | short_answer | true_false_ng | ...
  isCorrect     Boolean
  userAnswer    String
  correctAnswer String
  createdAt     DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id])
  attempt  Attempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)
  question Question @relation(fields: [questionId], references: [id])

  @@index([userId, skillType, questionType])
  @@index([userId, isCorrect])
  @@index([questionId])
  @@index([attemptId])
}

model WritingAnswer {
  id         Int      @id @default(autoincrement())
  userId     Int
  taskId     Int
  essayText  String
  wordCount  Int
  aiFeedback String?
  aiScore    Float?
  status     String   @default("pending")
  error      String?
  createdAt  DateTime @default(now())

  user          User                  @relation(fields: [userId], references: [id])
  task          WritingTask           @relation(fields: [taskId], references: [id])
  criterionLogs WritingCriterionLog[]

  @@index([userId])
  @@index([taskId])
  @@index([userId, taskId])
  @@index([createdAt])
}

model SpeakingAnswer {
  id         Int      @id @default(autoincrement())
  userId     Int
  partId     Int
  transcript String?
  aiFeedback String?
  aiScore    Float?
  status     String   @default("pending")
  error      String?
  createdAt  DateTime @default(now())

  user          User                   @relation(fields: [userId], references: [id])
  part          SpeakingPart           @relation(fields: [partId], references: [id])
  criterionLogs SpeakingCriterionLog[]

  @@index([userId])
  @@index([partId])
  @@index([userId, partId])
  @@index([createdAt])
}

model WritingCriterionLog {
  id              Int      @id @default(autoincrement())
  userId          Int
  writingAnswerId Int
  criterion       String   // "task_achievement" | "coherence_cohesion" | "lexical_resource" | "grammatical_range"
  score           Float
  comment         String?  @db.Text
  createdAt       DateTime @default(now())

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  writingAnswer WritingAnswer @relation(fields: [writingAnswerId], references: [id], onDelete: Cascade)

  @@index([userId, criterion])
  @@index([writingAnswerId])
}

model SpeakingCriterionLog {
  id               Int      @id @default(autoincrement())
  userId           Int
  speakingAnswerId Int
  criterion        String   // "fluency" | "vocabulary" | "grammar" | "pronunciation"
  score            Float
  comment          String?  @db.Text
  createdAt        DateTime @default(now())

  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  speakingAnswer   SpeakingAnswer @relation(fields: [speakingAnswerId], references: [id], onDelete: Cascade)

  @@index([userId, criterion])
  @@index([speakingAnswerId])
}

model QuestionGroup {
  id           Int     @id @default(autoincrement())
  sectionId    Int?
  passageId    Int?
  qNumberStart Int     @default(1)
  qNumberEnd   Int     @default(1)
  instruction  String  @default("")
  type         String
  imageUrl     String?
  sortOrder    Int     @default(0)
  canReuse     Boolean @default(false)
  maxChoices   Int     @default(2)

  section         ListeningSection? @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  passage         Passage?          @relation(fields: [passageId], references: [id], onDelete: Cascade)
  questions       Question[]
  noteSections    NoteSection[]
  matchingOptions MatchingOption[]

  @@index([sectionId])
  @@index([passageId])
}

model NoteSection {
  id        Int    @id @default(autoincrement())
  groupId   Int
  title     String @default("")
  sortOrder Int    @default(0)

  group QuestionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  lines NoteLine[]
}

model NoteLine {
  id                Int    @id @default(autoincrement())
  sectionId         Int
  contentWithTokens String @default("")
  lineType          String @default("content")
  sortOrder         Int    @default(0)

  noteSection NoteSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
}

model BookCover {
  id            Int        @id @default(autoincrement())
  seriesId      Int
  bookNumber    Int
  coverImageUrl String?
  deletedAt     DateTime?
  series        ExamSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@unique([seriesId, bookNumber])
  @@index([deletedAt])
  @@index([seriesId])
}

model ExamSeries {
  id         Int         @id @default(autoincrement())
  name       String
  createdAt  DateTime    @default(now())
  deletedAt  DateTime?
  bookCovers BookCover[]
  exams      Exam[]
  mappings   SeriesMapping[]

  @@index([deletedAt])
}

model Setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

// ─── PRACTICE EXAMS (standalone, not part of full-test) ──────────────────────
model PracticeExam {
  id           Int       @id @default(autoincrement())
  title        String
  skill        String    // reading | listening
  level        String?   // beginner | intermediate | advanced
  thumbnailUrl String?
  audioUrl     String?   // listening only
  passage      String?   // passage text (reading) or context (listening)
  isNormalized Boolean   @default(false)
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  questions    PracticeQuestion[]

  @@index([skill])
  @@index([createdAt])
}

model PracticeQuestion {
  id            Int          @id @default(autoincrement())
  examId        Int
  content       String
  type          String?
  orderNum      Int          @default(0)
  options       String?      // JSON array string
  correctAnswer String?
  createdAt     DateTime     @default(now())
  exam          PracticeExam @relation(fields: [examId], references: [id], onDelete: Cascade)
}

// ─── WRITING SAMPLES ──────────────────────────────────────────────────────────
model WritingSample {
  id           Int       @id @default(autoincrement())
  title        String
  level        String?   // task1 | task2
  examType     String?   // VD: "Bar chart", "Opinion essay"
  taskType     String?   // Normalized task type
  thumbnailUrl String?
  content      String?   // rich text HTML
  tags         String?   // JSON array
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  @@index([createdAt])
}

// ─── SPEAKING SAMPLES ─────────────────────────────────────────────────────────
model SpeakingSample {
  id           Int       @id @default(autoincrement())
  title        String
  level        String?   // task1 | task2 | task3
  examType     String?   // VD: "Describe a person", "Abstract discussion"
  thumbnailUrl String?
  content      String?   // rich text HTML
  tags         String?   // JSON array
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  parts SpeakingSamplePart[]

  @@index([createdAt])
}

model SpeakingSamplePart {
  id          Int      @id @default(autoincrement())
  sampleId    Int
  partNumber  Int
  title       String?
  description String?
  sample      SpeakingSample @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  questions   SpeakingSampleQuestion[]
}

model SpeakingSampleQuestion {
  id           Int    @id @default(autoincrement())
  partId       Int
  orderNum     Int
  questionText String
  part         SpeakingSamplePart @relation(fields: [partId], references: [id], onDelete: Cascade)
}

model MatchingOption {
  id           Int    @id @default(autoincrement())
  groupId      Int
  optionLetter String
  optionText   String @default("")
  sortOrder    Int    @default(0)

  group QuestionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

// ─── SERIES (new full-test series model) ──────────────────────────────────────
model Series {
  id           Int          @id @default(autoincrement())
  name         String
  description  String?
  thumbnailUrl String?
  type         String       @default("academic")
  createdAt    DateTime     @default(now())
  deletedAt    DateTime?
  exams        SeriesExam[]
  mappings     SeriesMapping[]

  @@index([createdAt])
  @@index([deletedAt])
}

model SeriesExam {
  id         Int    @id @default(autoincrement())
  seriesId   Int
  examId     Int
  testNumber Int
  series     Series @relation(fields: [seriesId], references: [id])
  exam       Exam   @relation(fields: [examId], references: [id])

  @@index([seriesId])
  @@index([examId])
}

model SeriesMapping {
  id           Int        @id @default(autoincrement())
  seriesId     Int
  examSeriesId Int
  createdAt    DateTime   @default(now())
  series       Series     @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  examSeries   ExamSeries @relation(fields: [examSeriesId], references: [id], onDelete: Cascade)

  @@index([seriesId])
  @@index([examSeriesId])
}
