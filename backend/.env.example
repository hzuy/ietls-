# Database (lấy từ Supabase > Project Settings > Database > Connection string > URI)
DATABASE_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"
# BẮT BUỘC: schema.prisma đặt directUrl = env("DIRECT_URL") nên mọi lệnh Prisma
# (migrate / db push / studio) đều cần biến này — thiếu là Prisma báo lỗi ngay.
# - Supabase: lấy URI "Direct connection" (cổng 5432), KHÔNG dùng pooler (6543).
# - Dev local: trỏ vào postgres-dev (xem backend/scripts/with-dev-db.js và
#   backend/docker-dev.env), vd: postgresql://postgres:postgres@127.0.0.1:5433/ielts_dev
DIRECT_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

# JWT (tạo chuỗi random bất kỳ, vd: openssl rand -base64 32)
JWT_SECRET="your-super-secret-jwt-key-here"

# Google Gemini AI (Primary provider)
GEMINI_API_KEY="AIzaSy_xxxxxxxxxxxxxxxxxxxx"
GEMINI_MODEL="gemini-3.5-flash-lite"
GEMINI_MAX_RPM=12 # Giới hạn số lượt gọi Gemini API mỗi phút để không vượt hạn mức 15 RPM (mặc định: 12)

# Groq AI (lấy từ console.groq.com)
GROQ_API_KEY="gsk_xxxxxxxxxxxxxxxxxxxx"

# Groq go model text cu kha thuong xuyen - neu gap loi 404 "model not found",
# goi GET https://api.groq.com/openai/v1/models (kem Authorization: Bearer GROQ_API_KEY)
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_REASONING_EFFORT="medium" # low | medium | high (ap dung cho model gpt-oss)
GROQ_VISION_MODEL="qwen/qwen3.8-27b" # Model da phuong thuc doc bieu do Writing Task 1

# URL frontend trên server (thêm vào CORS allowlist)
FRONTEND_URL="https://hzuy.net"

# Port backend (docker-compose set PORT=5001, Nginx proxy vào)
PORT=3001

# Cloud Storage (Cloudinary)
# Cách 1: Dùng 1 connection string duy nhất (khuyên dùng trên Render / Heroku / Railway)
# CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"
# Cách 2: Tách rời từng biến
# CLOUDINARY_CLOUD_NAME="your-cloud-name"
# CLOUDINARY_API_KEY="your-api-key"
# CLOUDINARY_API_SECRET="your-api-secret"
# Ghi chú: Nếu không cấu hình Cloudinary, hệ thống sẽ tự động fallback lưu vào local disk tại backend/uploads/

# Rate Limiting cho endpoint nộp bài (Tùy chọn ghi đè giá trị mặc định)
# RATE_LIMIT_SUBMIT_OBJECTIVE_MAX=20  # Tối đa lượt nộp Reading/Listening trong 15 phút (mặc định: 20)
# RATE_LIMIT_SUBMIT_AI_MAX=10         # Tối đa lượt nộp Writing/Speaking trong 15 phút (mặc định: 10)
# RATE_LIMIT_AI_EXPLANATION_MAX=30    # Tối đa lượt sinh/AI giải thích (admin exam + practice) trong 15 phút (mặc định: 30)
# RATE_LIMIT_WINDOW_MINUTES=15        # Thời gian cửa sổ tính rate limit tính bằng phút (mặc định: 15)

# Gửi email mã xác thực đăng ký (SMTP). Để trống khi dev: mã được in ra console backend.
# Production bắt buộc có — thiếu thì người đăng ký mới không nhận được mã.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_PASS là App Password 16 ký tự (không phải mật khẩu Gmail).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-account@gmail.com
# SMTP_PASS=your-app-password
# MAIL_FROM="IELTS Pro <your-account@gmail.com>"
